# ==============================================================================
# VOIDNOD Portfolio & Web Lab Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Ludo Royale - Online Multiplayer & Vercel Durable State Sync
# ------------------------------------------------------------------------------
# For serverless multi-instance deployments on Vercel, online multiplayer uses
# Upstash Redis REST API to store durable room state, matchmaking queues, and
# distribute real-time events across serverless function instances.
#
# When these variables are not configured, Ludo Royale automatically operates in
# a local in-memory fallback mode (ideal for single-instance or local dev).
# AI matches (Easy, Medium, Hard) and Local Pass-and-Play remain 100% functional.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# (Optional) External Dedicated WebSocket Server URL
# If hosting the WebSocket server separately (e.g., using scripts/ludo-server.ts on Railway/Render/Fly.io)
# Provide the public WebSocket endpoint URL below.
# Leave blank to use the built-in Vercel SSE & HTTP action endpoints (/api/ludo/*).
NEXT_PUBLIC_LUDO_WS_URL=""
